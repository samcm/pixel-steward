#!/opt/hermes/.venv/bin/python
"""Run a Hermes one-shot and export its exact persisted transcript as JSONL.

The Go controller owns budgets, lifecycle, and event persistence. This small
adapter keeps the integration on Hermes's supported one-shot path while making
the messages and tool calls Hermes stores in state.db available to the
operator transcript.
"""

from __future__ import annotations

import argparse
import json
import os
import sqlite3
import sys
from pathlib import Path
from typing import Any

from hermes_cli.oneshot import run_oneshot


def arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--prompt-file", required=True)
    parser.add_argument("--usage-file", required=True)
    parser.add_argument("--events-file", required=True)
    parser.add_argument("--model", required=True)
    parser.add_argument("--provider", required=True)
    parser.add_argument("--reasoning", required=True)
    parser.add_argument("--toolsets", default="studio")
    return parser.parse_args()


def decode_json(value: Any, fallback: Any) -> Any:
    if not value:
        return fallback
    if not isinstance(value, str):
        return value
    try:
        return json.loads(value)
    except (TypeError, ValueError):
        return fallback


def text_content(value: Any) -> str:
    if not isinstance(value, str):
        return ""
    prefix = "\x00json:"
    if not value.startswith(prefix):
        return value
    decoded = decode_json(value[len(prefix) :], [])
    if isinstance(decoded, list):
        return "\n".join(
            str(part.get("text", ""))
            for part in decoded
            if isinstance(part, dict) and part.get("type") == "text"
        )
    return str(decoded) if decoded is not None else ""


def tool_name(call: dict[str, Any]) -> str:
    function = call.get("function")
    if isinstance(function, dict) and function.get("name"):
        return str(function["name"])
    return str(call.get("name") or "tool")


def tool_arguments(call: dict[str, Any]) -> Any:
    function = call.get("function")
    raw = function.get("arguments") if isinstance(function, dict) else call.get("arguments")
    if isinstance(raw, str):
        return decode_json(raw, raw)
    return raw if raw is not None else {}


def export_events(usage_path: Path, events_path: Path) -> None:
    usage = decode_json(usage_path.read_text(encoding="utf-8"), {})
    session_id = usage.get("session_id") if isinstance(usage, dict) else None
    if not session_id:
        events_path.write_text("", encoding="utf-8")
        return

    home = Path(os.environ["HERMES_HOME"])
    uri = f"file:{home / 'state.db'}?mode=ro"
    connection = sqlite3.connect(uri, uri=True)
    connection.row_factory = sqlite3.Row
    try:
        rows = connection.execute(
            """SELECT id, role, content, tool_call_id, tool_calls, tool_name
               FROM messages
               WHERE session_id = ? AND active = 1
               ORDER BY id""",
            (session_id,),
        ).fetchall()
    finally:
        connection.close()

    results = {
        str(row["tool_call_id"]): text_content(row["content"])
        for row in rows
        if row["role"] == "tool" and row["tool_call_id"]
    }
    events: list[dict[str, Any]] = []
    for row in rows:
        if row["role"] != "assistant":
            continue
        content = text_content(row["content"]).strip()
        if content:
            events.append({"type": "text", "part": {"text": content}})
        calls = decode_json(row["tool_calls"], [])
        if not isinstance(calls, list):
            continue
        for call in calls:
            if not isinstance(call, dict):
                continue
            call_id = str(call.get("id") or "")
            state: dict[str, Any] = {
                "status": "completed" if call_id in results else "unknown",
                "input": tool_arguments(call),
            }
            if call_id in results:
                state["output"] = results[call_id]
            events.append(
                {"type": "tool_use", "part": {"tool": tool_name(call), "state": state}}
            )

    with events_path.open("w", encoding="utf-8") as output:
        for event in events:
            output.write(json.dumps(event, ensure_ascii=False) + "\n")


def include_auxiliary_usage(usage_path: Path) -> None:
    """Add Hermes auxiliary-model calls that the one-shot report omits."""
    usage = decode_json(usage_path.read_text(encoding="utf-8"), {})
    if not isinstance(usage, dict) or not usage.get("session_id"):
        return
    home = Path(os.environ["HERMES_HOME"])
    connection = sqlite3.connect(f"file:{home / 'state.db'}?mode=ro", uri=True)
    connection.row_factory = sqlite3.Row
    try:
        rows = connection.execute(
            """SELECT task, model, billing_provider, api_call_count,
                      input_tokens, output_tokens, cache_read_tokens,
                      cache_write_tokens, reasoning_tokens,
                      estimated_cost_usd, actual_cost_usd
               FROM session_model_usage
               WHERE session_id = ? AND task <> ''""",
            (usage["session_id"],),
        ).fetchall()
    finally:
        connection.close()
    if not rows:
        return
    fields = {
        "api_calls": "api_call_count",
        "input_tokens": "input_tokens",
        "output_tokens": "output_tokens",
        "cache_read_tokens": "cache_read_tokens",
        "cache_write_tokens": "cache_write_tokens",
        "reasoning_tokens": "reasoning_tokens",
    }
    for target, source in fields.items():
        usage[target] = int(usage.get(target) or 0) + sum(int(row[source] or 0) for row in rows)
    usage["estimated_cost_usd"] = float(usage.get("estimated_cost_usd") or 0) + sum(
        float(row["estimated_cost_usd"] or 0) for row in rows
    )
    usage["total_tokens"] = int(usage.get("input_tokens") or 0) + int(usage.get("output_tokens") or 0)
    usage["auxiliary_usage"] = [dict(row) for row in rows]
    usage_path.write_text(json.dumps(usage, indent=2) + "\n", encoding="utf-8")


def main() -> int:
    args = arguments()
    prompt = Path(args.prompt_file).read_text(encoding="utf-8")
    code = run_oneshot(
        prompt,
        model=args.model,
        provider=args.provider,
        toolsets=args.toolsets,
        usage_file=args.usage_file,
    )
    try:
        include_auxiliary_usage(Path(args.usage_file))
        export_events(Path(args.usage_file), Path(args.events_file))
    except Exception as error:  # transcript export must not hide model usage
        print(f"pixel-steward-hermes: transcript export failed: {error}", file=sys.stderr)
    return code


if __name__ == "__main__":
    raise SystemExit(main())
